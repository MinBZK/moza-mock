meta {
  name: 1. Contactgegeven aanmaken
  type: http
  seq: 1
}

post {
  url: {{profielUrl}}/api/profielservice/v1/contactgegeven
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "BSN",
    "identificatieNummer": "{{e2eBsn}}",
    "type": "Email",
    "waarde": "{{e2eEmail}}"
  }
}

vars:post-response {
  e2eContactgegevenId: res.body.id
}

tests {
  test("aangemaakt (201) of bestond al (200)", function() {
    expect([200, 201]).to.include(res.status);
  });

  test("response bevat een id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
