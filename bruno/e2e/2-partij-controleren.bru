meta {
  name: 2. Partij bevat het e-mailadres
  type: http
  seq: 2
}

post {
  url: {{profielUrl}}/api/profielservice/v1/partij
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "BSN",
    "identificatieNummer": "{{runBsn}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("contactgegevens bevatten het aangemaakte e-mailadres", function() {
    const waarden = (res.body.contactgegevens || []).map(c => c.waarde);
    expect(waarden).to.include(bru.getVar("runEmail"));
  });

  test("het profiel is dat van deze run", function() {
    const nummers = (res.body.identificaties || []).map(i => i.identificatieNummer);
    expect(nummers).to.include(bru.getVar("runBsn"));
  });
}
