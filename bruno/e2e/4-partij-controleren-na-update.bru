meta {
  name: 4. Partij bevat het nieuwe e-mailadres
  type: http
  seq: 4
}

post {
  url: {{profielUrl}}/api/profielservice/v1/partij
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "BSN",
    "identificatieNummer": "{{runBsn}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("contactgegevens bevatten het nieuwe e-mailadres", function() {
    const waarden = (res.body.contactgegevens || []).map(c => c.waarde);
    expect(waarden).to.include(bru.getVar("runEmailNieuw"));
  });

  test("het oude e-mailadres is weg", function() {
    const waarden = (res.body.contactgegevens || []).map(c => c.waarde);
    expect(waarden).to.not.include(bru.getVar("runEmail"));
  });
}
