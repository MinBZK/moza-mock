meta {
  name: 8. Partij is opgeruimd
  type: http
  seq: 8
}

post {
  url: {{profielUrl}}/api/profielservice/v1/partij
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "BSN",
    "identificatieNummer": "{{e2eBsn}}"
  }
}

assert {
  res.status: eq 404
}

tests {
  test("de partij zelf is niet meer opvraagbaar", function() {
    expect(res.body.title).to.equal("Partij niet gevonden");
  });
}
