meta {
  name: Centrale notificatie versturen
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/nmc/v1/centraal/notificaties
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "KVK",
    "identificatieNummer": "68750110",
    "dienstverlener": "RVO",
    "dienst": "eLoket",
    "berichtType": "Demo template",
    "berichtgegevens": {
      "naam": "Test BV Donald"
    }
  }
}

assert {
  res.status: eq 200
}
