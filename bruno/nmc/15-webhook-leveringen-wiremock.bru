meta {
  name: 15. Webhook-leveringen bij WireMock bekijken
  type: http
  seq: 15
}

get {
  url: {{eventsUrl}}/__admin/requests?limit=20
  body: none
  auth: basic
}

auth:basic {
  username: {{wiremockAdminUser}}
  password: {{wiremockAdminPassword}}
}

params:query {
  limit: 20
}

assert {
  res.status: eq 200
}

script:post-response {
  const leveringen = (res.body.requests || []).filter(r => r.request.url.startsWith("/events") && r.request.method === "POST");
  console.log("webhook-leveringen bij WireMock:", leveringen.length);
  for (const l of leveringen.slice(0, 3)) {
    console.log(l.request.loggedDate, "Nmc-Cursor:", l.request.headers["Nmc-Cursor"], "body:", l.request.body);
  }
  bru.setVar("webhookLeveringen", leveringen.length);
}

tests {
  const leveringen = (res.body.requests || []).filter(r => r.request.url.startsWith("/events") && r.request.method === "POST");
  test("er is minstens één levering op /events", function() {
    expect(leveringen.length, "geen leveringen: staat dienstverlener.webhook_url op {{eventsUrl}}/events en is de webhook-interval (10s) verstreken?").to.be.greaterThan(0);
  });
  if (leveringen.length > 0) {
    const laatste = leveringen[0].request;
    test("levering is een CloudEvents-batch met Nmc-Cursor", function() {
      expect(laatste.headers["Content-Type"]).to.include("application/cloudevents-batch+json");
      expect(laatste.headers["Nmc-Cursor"]).to.be.a("string");
      const batch = JSON.parse(laatste.body);
      expect(batch).to.be.an("array").with.length.greaterThan(0);
      expect(batch[0].type).to.match(/^nl\.overheid\.moz\.notificatie\.status\./);
    });
    test("bearer-JWT: RS256, kid uit JWKS, iss NMC, aud de webhook-URL", function() {
      const auth = laatste.headers["Authorization"] || "";
      expect(auth).to.match(/^Bearer /);
      const [h, p] = auth.slice(7).split(".");
      const dec = s => JSON.parse(Buffer.from(s.replace(/-/g, "+").replace(/_/g, "/"), "base64").toString());
      const header = dec(h), payload = dec(p);
      expect(header.alg).to.equal("RS256");
      const kid = bru.getVar("webhookKid");
      if (kid) { expect(header.kid).to.equal(kid); }
      expect(payload.iss).to.equal("https://mijnoverheidzakelijk.nl/nmc");
      expect(payload.aud).to.equal(bru.getEnvVar("eventsUrl") + "/events");
      expect(payload.exp * 1000).to.be.greaterThan(Date.now() - 24 * 3600 * 1000);
    });
  }
}

docs {
  Leest het request-journaal van de WireMock waar de webhook op wijst. Vooraf in de database van de
  omgeving:

    UPDATE dienstverlener SET webhook_url = '<eventsUrl>/events' WHERE id = '00000000-0000-4000-8000-000000000001';

  Daarna een intake-request (3 t/m 5) en 10 seconden wachten (`nmc.webhook.interval`). De stub
  antwoordt 202 op het pad alleen, dus elke levering slaagt en de leverpositie schuift op.
  Journaal leegmaken: `DELETE {{eventsUrl}}/__admin/requests`.

  Op ZAD zit de admin-API achter basic auth: vul `wiremockAdminUser` en `wiremockAdminPassword`
  in het environment in.
}
