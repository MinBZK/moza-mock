meta {
  name: CloudEvent afleveren
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: none
}

headers {
  Content-Type: application/cloudevents+json
}

body:json {
  {
    "specversion": "1.0",
    "type": "nl.overheid.notificaties.notificatie-status",
    "source": "urn:nld:oin:00000001003214345000:systeem:nmc",
    "id": "0f9e8d7c-6b5a-4c3d-8e1f-2a3b4c5d6e7f",
    "time": "2026-07-28T10:00:00Z",
    "datacontenttype": "application/json",
    "data": {
      "notificatieId": "0f9e8d7c-6b5a-4c3d-8e1f-2a3b4c5d6e7f",
      "status": "delivered"
    }
  }
}

assert {
  res.status: eq 202
}
