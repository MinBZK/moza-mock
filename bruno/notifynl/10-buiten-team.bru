meta {
  name: E-mail versturen (buiten team-key, 400)
  type: http
  seq: 10
}

post {
  url: {{notifynlUrl}}/notifynl/zelf/v2/notifications/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer mock-jwt
}

body:json {
  {
    "email_address": "buiten-team@testbv.nl",
    "template_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "personalisation": {
      "naam": "Donald"
    },
    "reference": "{{referenceId}}"
  }
}

assert {
  res.status: eq 400
  res.body.errors[0].error: eq BadRequestError
}

docs {
  `BadRequestError` zoals NotifyNL geeft voor een ontvanger die niet op de guest list van een
  team-key staat. Voor de NMC is dit een storing, geen adresafwijzing.
}
