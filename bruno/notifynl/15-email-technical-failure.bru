meta {
  name: E-mail versturen (receipt technical-failure)
  type: http
  seq: 15
}

post {
  url: {{notifynlUrl}}/notifynl/zelf/v2/notifications/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer mock-jwt
}

body:json {
  {
    "email_address": "donald+technical-failure@testbv.nl",
    "template_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "personalisation": {
      "naam": "Donald"
    },
    "reference": "{{referenceId}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: eq {{referenceId}}
}

docs {
  Zelfde als 2, met eindstatus `technical-failure`; de receipt wordt gecontroleerd in request 22.
}
