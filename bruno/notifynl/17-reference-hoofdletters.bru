meta {
  name: E-mail versturen (reference in hoofdletters, 400)
  type: http
  seq: 17
}

post {
  url: {{notifynlUrl}}/notifynl/zelf/v2/notifications/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer mock-jwt
}

body:json {
  {
    "email_address": "donald+hoofdletters@testbv.nl",
    "template_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "personalisation": {
      "naam": "Donald"
    },
    "reference": "7C6D5E4F-3A2B-4C1D-9E8F-0A1B2C3D4E5F"
  }
}

assert {
  res.status: eq 400
  res.body.errors[0].error: eq MockError
}

docs {
  Een `reference` die geen UUID in kleine letters is, krijgt dezelfde 400 als een ontbrekende
  `reference` (request 16); er gaat geen receipt uit (request 22).
}
