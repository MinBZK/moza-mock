meta {
  name: E-mail versturen (geen receipt, navraag blijft sending)
  type: http
  seq: 19
}

post {
  url: {{notifynlUrl}}/notifynl/zelf/v2/notifications/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer mock-jwt
}

body:json {
  {
    "email_address": "donald+geen-receipt-sending@testbv.nl",
    "template_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "personalisation": {
      "naam": "Donald"
    },
    "reference": "{{referenceId}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: startsWith 5e4d1400-
  res.body.reference: eq {{referenceId}}
}

docs {
  Als 4, met id-prefix `5e4d1400-`: de navraag op dat id blijft `sending` (request 20).
}
