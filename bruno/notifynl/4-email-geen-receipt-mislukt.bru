meta {
  name: E-mail versturen (geen receipt, navraag geeft permanent-failure)
  type: http
  seq: 4
}

post {
  url: {{notifynlUrl}}/notifynl/zelf/v2/notifications/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer mock-jwt
}

body:json {
  {
    "email_address": "donald+geen-receipt-mislukt@testbv.nl",
    "template_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "personalisation": {
      "naam": "Donald"
    },
    "reference": "{{referenceId}}"
  }
}

vars:post-response {
  navraagMisluktId: res.body.id
}

assert {
  res.status: eq 201
  res.body.id: startsWith ffffffff-
  res.body.reference: eq {{referenceId}}
}

docs {
  Als 3, maar het `id` krijgt prefix `ffffffff-`, waarop de navraag `permanent-failure` geeft
  (request 6). Andere prefixen: `40440440-` (404, request 7) via `geen-receipt-onbekend`,
  `5e4d1400-` (blijft `sending`) via `geen-receipt-sending`.
}
