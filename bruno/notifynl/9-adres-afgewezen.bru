meta {
  name: E-mail versturen (adres afgewezen, 400)
  type: http
  seq: 9
}

post {
  url: {{notifynlUrl}}/notifynl/zelf/v2/notifications/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer mock-jwt
}

body:json {
  {
    "email_address": "afgewezen@testbv.nl",
    "template_id": "a1b2c3d4-0000-4000-8000-000000000001",
    "personalisation": {
      "naam": "Donald"
    },
    "reference": "{{referenceId}}"
  }
}

assert {
  res.status: eq 400
  res.body.errors[0].error: eq ValidationError
  res.body.errors[0].message: contains email_address
}

docs {
  `ValidationError` op `email_address`: de enige 400 die de NMC als adresafwijzing behandelt.
}
