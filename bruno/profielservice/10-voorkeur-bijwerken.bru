meta {
  name: Voorkeur bijwerken
  type: http
  seq: 10
}

put {
  url: {{profielUrl}}/api/profielservice/v1/voorkeur
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "KVK",
    "identificatieNummer": "68750110",
    "voorkeurType": "WebsiteTaal",
    "waarde": "en",
    "id": "{{voorkeurId}}"
  }
}

assert {
  res.status: eq 200
}
