meta {
  name: Contactgegeven bijwerken - verwijderd
  type: http
  seq: 19
}

put {
  url: {{profielUrl}}/api/profielservice/v1/contactgegeven
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "KVK",
    "identificatieNummer": "68750110",
    "type": "Email",
    "waarde": "nieuw@testbv.nl",
    "id": "{{verwijderdContactgegevenId}}"
  }
}

docs {
  Een contactgegeven met een soft delete is niet meer vindbaar en kan dus ook niet meer
  worden bijgewerkt.
}

assert {
  res.status: eq 404
}
