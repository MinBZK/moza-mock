meta {
  name: Voorkeur bijwerken - verwijderd
  type: http
  seq: 21
}

put {
  url: {{profielUrl}}/api/profielservice/v1/voorkeur
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "KVK",
    "identificatieNummer": "68750110",
    "voorkeurType": "WebsiteTaal",
    "waarde": "en",
    "id": "{{verwijderdVoorkeurId}}"
  }
}

docs {
  Een voorkeur met een soft delete is niet meer vindbaar en kan dus ook niet meer worden
  bijgewerkt.
}

assert {
  res.status: eq 404
}
