meta {
  name: Contactgegeven bijwerken
  type: http
  seq: 7
}

put {
  url: {{profielUrl}}/api/profielservice/v1/contactgegeven
  body: json
  auth: none
}

body:json {
  {
    "identificatieType": "KVK",
    "identificatieNummer": "68750110",
    "type": "Email",
    "waarde": "nieuw@testbv.nl",
    "id": "{{contactgegevenId}}",
    "isDefault": true
  }
}

assert {
  res.status: eq 200
}
