    {
      "name": "NotifyNL e-mail: traag (antwoord na 35 s, voorbij de 30 s read-timeout van de NMC)",
      "priority": 3,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/notifynl/[a-z0-9-]+)?/v2/notifications/email",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.reference",
              "matches": "[0-9a-f]{8}-[0-9a-f-]{27}"
            }
          },
          {
            "matchesJsonPath": {
              "expression": "$.email_address",
              "contains": "traag"
            }
          }
        ]
      },
      "response": {
        "status": 201,
        "fixedDelayMilliseconds": 35000,
        "headers": {
          "Content-Type": "application/json"
        },
        "transformers": [
          "response-template"
        ],
        "bodyFileName": "notifynl/email-response.json"
      }
    },
