{
  "mappings": [
    {
      "name": "NotifyNL e-mail: adres afgewezen (400 ValidationError op email_address)",
      "priority": 3,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/notifynl/[a-z0-9-]+)?/v2/notifications/email",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.email_address",
              "contains": "afgewezen"
            }
          }
        ]
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyFileName": "notifynl/fout-adres-afgewezen-response.json"
      }
    },
