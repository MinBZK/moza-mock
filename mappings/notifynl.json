        {
          "name": "webhook",
          "parameters": {
            "method": "POST",
            "url": "{{#assign 'target'}}{{regexExtract originalRequest.path '^/notifynl/([a-z0-9-]+)/' 'm' default='stable'}}{{m.0}}{{/assign}}{{#eq target 'lokaal'}}{{systemValue type='ENVIRONMENT' key='WIREMOCK_NOTIFYNL_LOKAAL_URL' default='http://host.containers.internal:8080'}}{{else}}{{#eq target 'zelf'}}http://localhost:8080{{else}}https://nmcapi-{{target}}-nd-j7s.rig.prd1.gn2.quattro.rijksapps.nl{{/eq}}{{/eq}}/api/nmc/v1/notifynl-callback",
            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{systemValue type='ENVIRONMENT' key='WIREMOCK_NOTIFYNL_CALLBACK_TOKEN'}}"
            },
            "body": "{\"id\":\"{{jsonPath originalRequest.body '$.reference'}}\",\"reference\":\"{{jsonPath originalRequest.body '$.reference'}}\",\"to\":\"{{jsonPath originalRequest.body '$.email_address'}}\",\"status\":\"sending\",\"notification_type\":\"email\",\"created_at\":\"{{now timezone='UTC' format=\"yyyy-MM-dd'T'HH:mm:ssXXX\"}}\",\"sent_at\":\"{{now timezone='UTC' format=\"yyyy-MM-dd'T'HH:mm:ssXXX\"}}\",\"completed_at\":null}",
            "delay": {
              "type": "fixed",
              "milliseconds": 1000
            }
          }
        },
