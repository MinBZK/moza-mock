            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{systemValue type='ENVIRONMENT' key='WIREMOCK_NOTIFYNL_CALLBACK_TOKEN'}}"
            },
            "body": "{\"id\":\"{{jsonPath originalRequest.body '$.reference'}}\",\"reference\":\"{{jsonPath originalRequest.body '$.reference'}}\",\"to\":\"{{jsonPath originalRequest.body '$.email_address'}}\",\"status\":\"permanent-failure\",\"notification_type\":\"email\",\"created_at\":\"{{now timezone='UTC' format=\"yyyy-MM-dd'T'HH:mm:ssXXX\"}}\",\"sent_at\":\"{{now timezone='UTC' format=\"yyyy-MM-dd'T'HH:mm:ssXXX\"}}\",\"completed_at\":\"{{now timezone='UTC' format=\"yyyy-MM-dd'T'HH:mm:ssXXX\"}}\"}",
